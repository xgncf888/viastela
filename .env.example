# Copy to .env.local. Expo inlines EXPO_PUBLIC_* at bundle time; restart the dev server after edits.
# Local stack: `npx supabase start` then `npx supabase status` and paste the API URL and anon key.
# These are public client values. Never put the service role key in this file or in the app.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Set after `eas init` when you are ready for EAS Update. Week 1 does not ship updates.
# EXPO_PUBLIC_EAS_UPDATE_URL=https://u.expo.dev/<project-uuid>
# EAS_PROJECT_ID=
